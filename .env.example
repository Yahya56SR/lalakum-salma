BOT_TOKEN=YOUR_BOT_TOKEN_HERE
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Optional. Without GUILD_ID the dashboard uses the first server the bot is in.
GUILD_ID=

# ---------------------------------------------------------------------------
# Web dashboard (runs inside the bot process)
# ---------------------------------------------------------------------------
# http://127.0.0.1:3000
DASHBOARD_ENABLED=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000
# Set a password to require a login. Leave blank for localhost-only access.
# Required if DASHBOARD_HOST is not a loopback address.
DASHBOARD_PASSWORD=
